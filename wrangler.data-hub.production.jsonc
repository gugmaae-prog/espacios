{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "espacios-data-hub",
  "main": "src/data-hub/worker.js",
  "account_id": "b1b843ec85bc39a3a4d370ba4f84f17a",
  "workers_dev": false,
  "preview_urls": false,
  "compatibility_date": "2026-09-26",
  "d1_databases": [{ "binding": "REGISTRY", "database_name": "espacios-data-registry", "database_id": "3ad3a1ff-83cc-42fa-a106-d6f715e1e967" }],
  "services": [{ "binding": "AUTH", "service": "espacios-auth-central", "environment": "production" }],
  "observability": { "enabled": true, "head_sampling_rate": 1, "redact_query_string": false, "logs": { "enabled": true, "head_sampling_rate": 1, "persist": true, "invocation_logs": true }, "traces": { "enabled": false, "persist": true, "head_sampling_rate": 1 } },
  "vars": { "DATA_RELEASE": "espacios-data-hub-v11-cache-provenance" }
  // R2 ARCHIVES is intentionally omitted while the owner keeps R2 disabled.
  // Keep the existing DATA_ADMIN_EMAILS with --keep-vars during version upload.
  // Routes are managed separately; versions upload must not change triggers.
}
